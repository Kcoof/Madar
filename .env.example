# PostgreSQL connection string (Supabase — from Project Settings > Database)
# Used only by Prisma for schema management and migrations.
DATABASE_URL=

# Supabase project public URL (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser (RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — BYPASSES RLS. Server-side administrative use only.
# Must NEVER be exposed to the client or returned in any API response.
SUPABASE_SERVICE_ROLE_KEY=
